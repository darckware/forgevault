<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>fv</AssemblyName>
    <RootNamespace>ForgeVault.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Deliberately zero ProjectReference to Domain/Infrastructure/Application (docs/modules/08_CLI_SDK.md
    §2: "este módulo é puramente cliente sobre a API já existente" — a client has no business
    reading server-side entities/DbContext, and staying decoupled means the CLI can be shipped
    and versioned independently of the API someday). Only the BCL's own HttpClient/System.Text.Json —
    no third-party CLI parsing library — keeps this buildable offline with zero new NuGet surface.
  -->

</Project>

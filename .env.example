# Copy this file to .env (gitignored) and fill in real values as needed.
# docker-compose.yml reads .env automatically from the repo root.

# Login screen reCAPTCHA v2 (see docker-compose.yml, src/ForgeVault.Web/Dockerfile,
# src/ForgeVault.Infrastructure/Auth/RecaptchaOptions.cs). Both empty = feature off
# (fail-open, login unaffected) — same convention as the sibling ForgeHub/Darckware
# projects. RECAPTCHA_SITE_KEY is public (baked into the frontend at build time via
# docker-compose.yml's build arg); RECAPTCHA_SECRET_KEY is read by the backend at runtime
# and must never be committed once set. Create the key pair at
# https://www.google.com/recaptcha/admin/create (type: reCAPTCHA v2 "I'm not a robot"
# checkbox) — add both the Tailscale hostname (forgevault.<tailnet>.ts.net) and any other
# real domain this is served from as allowed domains; localhost is always accepted by
# Google without needing to be listed, so local dev works without any extra entry.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Build identity surfaced at GET /api/v1/system/version — set automatically by
# deploy/scripts/build.sh; only needed here if you build some other way and still want
# real values instead of "unknown".
FORGEVAULT_VERSION=
FORGEVAULT_GIT_SHA=
FORGEVAULT_BUILD_DATE=
